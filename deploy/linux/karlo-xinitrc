#!/usr/bin/env sh
set -eu

if [ -f /etc/karlo/karlo.env ]; then
  set -a
  . /etc/karlo/karlo.env
  set +a
fi

karlo_root="${KARLO_ROOT:-/opt/karlo}"
current_appimage="${karlo_root}/current/Karlo.AppImage"

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

if command -v xset >/dev/null 2>&1; then
  xset s off
  xset -dpms
  xset s noblank
fi

systemctl --user daemon-reload
systemctl --user import-environment DISPLAY XAUTHORITY HOME USER LOGNAME XDG_RUNTIME_DIR

start_karlo_if_ready() {
  if systemctl --user is-active --quiet karlo-preview.service; then
    return
  fi

  if [ -x "$current_appimage" ] && ! systemctl --user is-active --quiet karlo.service; then
    systemctl --user start karlo.service
  fi
}

start_karlo_if_ready

cleanup() {
  systemctl --user stop karlo.service karlo-preview.service >/dev/null 2>&1 || true
}

trap cleanup EXIT HUP INT TERM

while :; do
  sleep 5 &
  wait $!
  start_karlo_if_ready
done
