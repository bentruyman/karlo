# Copy this file to ops/cabinet.env and edit for the real cabinet.
# Read by ops/sync-arcade-library.sh.

# Hostname or IP address reachable from this development machine.
KARLO_CABINET_HOST=karlo-cabinet.local

# SSH user used for the library sync. This user must be able to run sudo on the cabinet.
KARLO_CABINET_SSH_USER=ben

# Dedicated local account that owns the cabinet session and the synced library.
KARLO_CABINET_USER=karlo

# Where the staged library lands on the cabinet.
KARLO_LIBRARY_REMOTE_ROOT=/srv/karlo/library
